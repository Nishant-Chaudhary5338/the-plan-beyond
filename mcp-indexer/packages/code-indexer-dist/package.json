{
  "name": "@mcp-toolkit/code-indexer",
  "version": "0.1.0",
  "type": "module",
  "mcpName": "io.github.nishant-chaudhary5338/code-indexer",
  "description": "Index any TypeScript/React repo into a queryable code graph — npx CLI, HTTP/WS server, and MCP server (who-renders, who-calls, find-references, blast-radius, cycles).",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "code-graph",
    "code-intelligence",
    "react",
    "typescript",
    "ts-morph",
    "claude",
    "ai-tools"
  ],
  "license": "MIT",
  "author": "Nishant Chaudhary <nishantchaudhary.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishant-Chaudhary5338/mcp-toolkit.git",
    "directory": "packages/code-indexer-dist"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "code-graph-indexer": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js",
    "./serve": "./dist/serve.js",
    "./core": "./dist/core.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@parcel/watcher": "^2.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "ts-morph": "^24.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@repo/code-graph-core": "workspace:*",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "code-indexer-mcp": "workspace:*",
    "indexer-server": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
