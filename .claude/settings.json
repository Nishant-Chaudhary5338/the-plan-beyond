      "Bash(pnpm run test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm run ci:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm index:app:*)",
      "Bash(pnpm -C app *)",
      "Bash(pnpm -C mcp-indexer *)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prettier --check:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(node -v)",
      "Bash(node -e:*)",
